# Server-resolved policy. Never read from request input.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/internal_tools
REFUND_APPROVAL_THRESHOLD_CENTS=50000
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000
# Optional: enables live Devin session triggering from /platform/devin.
DEVIN_API_KEY=
# Optional: Slack webhooks per lane. When unset, messages are written
# to .devin/slack-outbox.md instead of posted.
SLACK_WEBHOOK_INTERNAL_TOOLS=
SLACK_WEBHOOK_PLATFORM=
